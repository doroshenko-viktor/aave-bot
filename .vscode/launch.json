{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'bot'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=bot",
                    "--package=bot"
                ],
                "filter": {
                    "name": "bot",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "initCommands": [
                "settings set target.process.thread.step-avoid-regexp 'Future::poll|tokio::.*|std::.*|core::.*'"
            ],
            "postRunCommands": [
                "settings set target.max-memory-read-size 65536",
                "settings set target.process.thread.step-avoid-regexp '.*poll.*|.*tokio.*'"
            ],
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'bot'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=bot",
                    "--package=bot"
                ],
                "filter": {
                    "name": "bot",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'graph'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=graph",
                    "--package=graph"
                ],
                "filter": {
                    "name": "graph",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in executable 'graph'",
            "cargo": {
                "args": [
                    "test",
                    "--no-run",
                    "--bin=graph",
                    "--package=graph"
                ],
                "filter": {
                    "name": "graph",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}